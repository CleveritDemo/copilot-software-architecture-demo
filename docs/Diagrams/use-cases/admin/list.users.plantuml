@startuml list.users

title Ver listado de todos los usuarios — Usuario Administrador

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Administrador" as Admin

rectangle "Sistema de Registro de Eventos" {
  usecase "Acceder a sección Usuarios" as UC1

  usecase "Consultar todos los User (Regla 10)" as S1
  usecase "Mostrar listado con username, email, rol y demás campos" as S2
}

Admin --> UC1

UC1 ..> S1 : <<include>>
S1 ..> S2 : <<include>>

@enduml
