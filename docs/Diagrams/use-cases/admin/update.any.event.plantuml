@startuml update.any.event

title Modificar cualquier evento — Usuario Administrador

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Administrador" as Admin

rectangle "Sistema de Registro de Eventos" {
  usecase "Seleccionar Event en el listado" as UC1
  usecase "Ingresar modificaciones" as UC2
  usecase "Guardar cambios" as UC3

  usecase "Validar formato de los campos" as S1
  usecase "Persistir cambios en el Event (Regla 5)" as S2
}

Admin --> UC1
Admin --> UC2
Admin --> UC3

UC3 ..> S1 : <<include>>
S1 ..> S2 : <<include>>

@enduml
