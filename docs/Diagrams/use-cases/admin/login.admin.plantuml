@startuml login.admin

title Iniciar sesión como administrador — Usuario Administrador

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Administrador" as Admin

rectangle "Sistema de Registro de Eventos" {
  usecase "Abrir pantalla de login" as UC1
  usecase "Ingresar credenciales admin" as UC2
  usecase "Enviar formulario" as UC3

  usecase "Validar credenciales de administrador" as S1
  usecase "Crear sesión (role = administrador)" as S2
  usecase "Redirigir al módulo de administración" as S3

  usecase "Mostrar error de credenciales inválidas" as A1
}

Admin --> UC1
Admin --> UC2
Admin --> UC3

UC3 ..> S1 : <<include>>
S1 ..> S2 : <<include>>
S2 ..> S3 : <<include>>

S1 ..> A1 : <<extend>>

note right of A1
  Flujo alternativo A1:
  credenciales inválidas.
  No se crea sesión.
end note

@enduml
