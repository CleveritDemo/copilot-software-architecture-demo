@startuml list.all.events

title Ver listado de todos los eventos — Usuario Administrador

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Administrador" as Admin

rectangle "Sistema de Registro de Eventos" {
  usecase "Acceder a sección Eventos" as UC1

  usecase "Consultar todos los Event (Regla 8)" as S1
  usecase "Mostrar listado completo con creador, fecha, estado y enlace" as S2
}

Admin --> UC1

UC1 ..> S1 : <<include>>
S1 ..> S2 : <<include>>

@enduml
