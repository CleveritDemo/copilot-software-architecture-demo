@startuml delete.user

title Eliminar usuario — Usuario Administrador

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Administrador" as Admin

rectangle "Sistema de Registro de Eventos" {
  usecase "Seleccionar User y elegir Eliminar" as UC1
  usecase "Confirmar eliminación" as UC2

  usecase "Solicitar confirmación" as S1
  usecase "Eliminar User y sus filas UserEvent" as S2

  usecase "Advertir eventos activos como organizador" as A1
}

Admin --> UC1
Admin --> UC2

UC1 ..> S1 : <<include>>
UC2 ..> S2 : <<include>>

S2 ..> A1 : <<extend>>

note right of A1
  Flujo alternativo A1:
  el User es organizador de
  eventos activos. Confirmar
  eliminación en cascada o
  cancelar la operación.
end note

@enduml
