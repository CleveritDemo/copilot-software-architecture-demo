@startuml view.invitations

title Ver mis invitaciones — Usuario Común (rol funcional: asistente)

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Común" as UC

rectangle "Sistema de Registro de Eventos" {
  usecase "Acceder a la sección de invitaciones" as UC1

  usecase "Consultar filas UserEvent donde userId = usuario actual" as S1
  usecase "Mostrar eventos invitados con estado de respuesta" as S2
}

UC --> UC1

UC1 ..> S1 : <<include>>
S1 ..> S2 : <<include>>

@enduml
