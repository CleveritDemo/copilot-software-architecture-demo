@startuml update.own.event

title Modificar evento — Usuario Común (rol funcional: organizador)

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Usuario Común" as UC

rectangle "Sistema de Registro de Eventos" {
  usecase "Acceder al detalle del evento propio" as UC1
  usecase "Ingresar modificaciones" as UC2
  usecase "Guardar cambios" as UC3

  usecase "Verificar que el usuario es el creador (Regla 5)" as S1
  usecase "Validar formato de los campos" as S2
  usecase "Persistir cambios en el Event" as S3

  usecase "Denegar acceso: no es el creador" as A1
}

UC --> UC1
UC --> UC2
UC --> UC3

UC1 ..> S1 : <<include>>
UC3 ..> S2 : <<include>>
S2 ..> S3 : <<include>>

S1 ..> A1 : <<extend>>

note right of A1
  Flujo alternativo A1:
  el usuario no es el creador
  del evento. No se aplica
  ningún cambio.
end note

@enduml
